        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Wird geladen"
          }
        }
      }
    },
    "%@, charging" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, wird geladen"
          }
        }
      }
    },
    "%@. Turn the chat mix dial on the headset to change it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Zum Ändern das ChatMix-Rad am Headset drehen."
          }
        }
      }
    },
    "%@: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@."
          }
        }
      }
    },
