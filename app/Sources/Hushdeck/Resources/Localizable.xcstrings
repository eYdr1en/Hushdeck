      "comment" : "Auto-off delay in minutes",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Min."
          }
        }
      }
    },
    "%lld settings · %@" : {
      "comment" : "Profile summary: count and modification date",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Einstellungen · %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld settings · %2$@"
          }
        }
      }
