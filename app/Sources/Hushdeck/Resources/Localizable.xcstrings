    "2.4 GHz equalizer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,4-GHz-Equalizer"
          }
        }
      }
    },
    "2.4 GHz link" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,4-GHz-Verbindung"
          }
        }
      }
    },
    "2.4 GHz wireless equalizer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,4-GHz-Funk-Equalizer"
          }
        }
      }
    },
    "A profile stores every setting from the Audio, Microphone and Headset & Hub tabs, plus the three equalizers. Applying one sends the settings and saves them to the GameHub, the way SteelSeries GG deploys a configuration. Equalizers are sent only while EQ writes are on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Profil speichert alle Einstellungen der Bereiche Audio, Mikrofon und Headset & Hub sowie die drei Equalizer. Beim Anwenden werden die Einstellungen gesendet und auf dem GameHub gespeichert, so wie SteelSeries GG eine Konfiguration überträgt. Equalizer werden nur gesendet, solange EQ-Schreibzugriffe aktiv sind."
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über"
          }
        }
