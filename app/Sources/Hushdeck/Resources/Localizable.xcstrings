{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (like SteelSeries GG)" : {
      "comment" : "Low battery threshold that matches GG's own rule",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (wie SteelSeries GG)"
          }
        }
      }
    },
    "%@ copy" : {
      "comment" : "Name of a duplicated profile",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Kopie"
          }
        }
      }
    },
    "%@ decibels" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dezibel"
          }
        }
      }
    },
    "%@ is at %@. Charge it soon." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist bei %2$@. Bitte bald aufladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is at %2$@. Charge it soon."
          }
        }
      }
    },
    "%@ is connected through HeadsetControl. Its controls are in the menu bar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist über HeadsetControl verbunden. Die Steuerung dafür ist in der Menüleiste."
          }
        }
      }
    },
    "%@ is fully charged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist vollständig geladen."
          }
        }
      }
    },
    "%@ kHz" : {
      "comment" : "Frequency in kilohertz",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kHz"
          }
        }
      }
    },
    "%@ to %@ dB" : {
      "comment" : "Equalizer range, e.g. -12 to +12 dB",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bis %2$@ dB"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ to %2$@ dB"
          }
