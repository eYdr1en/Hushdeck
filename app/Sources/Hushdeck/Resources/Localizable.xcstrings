    },
    "Confirmed on the hub: new bands are stored in its Custom slot, and factory presets keep their built-in curves. Turn this off to keep equalizer edits in Hushdeck only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Hub bestätigt: Neue Bänder werden im Custom-Speicherplatz abgelegt, Werks-Presets behalten ihre eingebauten Kurven. Schalte dies aus, damit Equalizer-Änderungen nur in Hushdeck bleiben."
          }
        }
      }
    },
    "Connect the base station or USB receiver. Hushdeck checks again every %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe die Basisstation oder den USB-Empfänger an. Hushdeck sucht alle %@ erneut."
